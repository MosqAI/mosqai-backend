# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://mosqai:mosqai_dev_password@localhost:5432/mosqai_dev?schema=public
# Pool size. Use 1 with the embedded `pnpm dev:db` server (it serves one connection).
DATABASE_POOL_MAX=10
# Browser origins allowed to call the API (authority web)
CORS_ORIGINS=http://localhost:3001

JWT_ACCESS_SECRET=change-me-dev-only
JWT_ACCESS_TTL=15m
# Refresh tokens are random, stored hashed, and rotated on every use.
JWT_REFRESH_TTL=30d

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=mosqai-backend
MQTT_PASSWORD=change-me-dev-only
DEVICE_HEARTBEAT_TIMEOUT_S=90
COMMAND_ACK_TIMEOUT_S=30

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-dev-only
